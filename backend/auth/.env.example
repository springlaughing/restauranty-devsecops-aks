# RS256 private key that signs login tokens. Only auth has it. Never commit a real one.
# Create a key pair: README, section "JWT keys". The placeholder below stops the app on purpose.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"
JWT_ISSUER=restauranty-auth
JWT_AUDIENCE=restauranty-api
MONGODB_URI="mongodb://127.0.0.1:27017/resturanty"
CLOUD_NAME="cloudinaryname"
CLOUD_API_KEY="cloudinaryapikey"
CLOUD_API_SECRET="cloudinaryapisecret"
PORT=3001